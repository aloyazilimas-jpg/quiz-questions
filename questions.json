        "id": i,
        "soru": base["soru"],
        "secenekler": base["secenekler"].copy(),
        "dogru": base["dogru"]
    })

with open("questions_10000.json", "w", encoding="utf-8") as f:
    json.dump({"questions": questions}, f, ensure_ascii=False, indent=2)

