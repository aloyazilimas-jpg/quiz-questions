# Mevcut 20 soruyu 10000'e tamamlamak için kopyala
original_count = len(questions)
target_count = 10000

for i in range(original_count, target_count):
    # Mevcut soruları döngüsel olarak kopyala
    base_idx = i % original_count
    base_question = questions[base_idx].copy()
    
    # Yeni soru oluştur
    new_question = {
        "id": i,
        "soru": base_question["soru"].replace(str(base_idx), str(i)),
        "secenekler": base_question["secenekler"].copy(),
        "dogru": base_question["dogru"]
    }
    questions.append(new_question)

# JSON'a yaz
with open('questions_10000.json', 'w', encoding='utf-8') as f:
    json.dump({"questions": questions}, f, ensure_ascii=False, indent=2)

print(f"{len(questions)} soru kaydedildi.")
